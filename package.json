{
  "name": "aviation",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "docker compose --profile infra up -d && pnpm --filter turnaround-iq dev",
    "build": "pnpm -r --if-present build",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:e2e": "pnpm --filter turnaround-iq test:e2e",
    "bench:replan": "node scripts/benchmarks/replan-delay.mjs",
    "eval:mro": "node scripts/eval-mro/retrieval.mjs",
    "bench:mro-search": "node scripts/benchmarks/mro-search-latency.mjs",
    "loadtest": "node scripts/loadtest/run-loadtest.mjs",
    "loadtest:mro": "node scripts/loadtest/run-mro-loadtest.mjs",
    "seed": "pnpm --filter turnaround-iq seed",
    "seed:mro": "pnpm --filter mro-copilot seed",
    "seed:rebook": "pnpm --filter rebook-ai seed",
    "db:generate": "pnpm --filter @aviation/db generate",
    "db:generate:mro": "pnpm --filter mro-copilot db:generate",
    "db:generate:rebook": "pnpm --filter rebook-ai db:generate",
    "db:migrate": "pnpm --filter @aviation/db migrate",
    "db:migrate:mro": "pnpm --filter mro-copilot db:migrate",
    "db:migrate:rebook": "pnpm --filter rebook-ai db:migrate",
    "eval:mro:full": "node scripts/eval-mro/full.mjs",
    "bench:mro-ask": "node scripts/benchmarks/mro-ask-latency.mjs",
    "test:e2e:mro": "pnpm --filter mro-copilot test:e2e"
  },
  "devDependencies": {
    "@aviation/config": "workspace:*",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.20.0"
  }
}
