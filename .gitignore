# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.next/
.next-off/
out/
*.tsbuildinfo

# Landing page host-only deploy content (ADR-0019) — built out/ is copied
# here by the runbook; the runbook itself stays tracked.
infra/deploy/landing/*
!infra/deploy/landing/README.md

# ro-botriv SPA host-only deploy content — built dist/ is copied here by
# ro-botriv scripts/deploy-web.sh (see compose.prod.yml); source lives in the
# ro-botriv repo, not here.
infra/deploy/ro-botriv-web/

# env & secrets
.env
.env.local
.env.*.local

# tooling
coverage/
.eslintcache
.turbo/

# os
.DS_Store

# Playwright artifacts (F3 e2e)
apps/turnaround-iq/test-results/
apps/mro-copilot/test-results/
apps/turnaround-iq/playwright-report/

# Python tooling caches (mro-copilot ai-service)
__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# C-MAPSS downloaded dataset (F4): pinned download.sh output, never committed
# (the committed synthetic sample under seed/cmapss/sample/ is the CI path).
apps/mro-copilot/seed/cmapss/data/
apps/rebook-ai/test-results/
apps/rebook-ai/playwright-report/
