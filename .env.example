# TurnaroundIQ local development — every value here is a throwaway dev default.
# Copy to .env for host-side runs:  cp .env.example .env

# PostgreSQL (docker compose profile "infra" publishes 5433 on the host)
DATABASE_URL=postgresql://turnaround:turnaround@localhost:5433/turnaround_iq

# Redis (compose publishes 6379 on the host) — live projections + pub/sub only
REDIS_URL=redis://localhost:6379

# Session signing secret. Generate a real one: openssl rand -base64 32
# Must match for web AND realtime-gateway (ws tokens share the key).
AUTH_SECRET=replace-with-a-generated-32+-char-secret

# Session cookie name (httpOnly)
AUTH_COOKIE_NAME=tiq_session

# Realtime gateway ws endpoint the browser connects to (compose publishes 4001)
NEXT_PUBLIC_WS_URL=ws://localhost:4001/api/ws

# Service ports (compose: simulator 4101, realtime-gateway 4001)
SIMULATOR_PORT=4101
GATEWAY_PORT=4001

# LLM gateway provider — "mock" is the mandatory offline default (ADR-0003).
# "off" disables the provider so the copilot degrades to rules (source: rules);
# "openai-compatible"/"bedrock-shape" are registered but not implemented yet.
LLM_PROVIDER=mock

# ---------------------------------------------------------------------------
# mro-copilot (compose profile "mro": web :3003, ai-service :4103 loopback)
# ---------------------------------------------------------------------------

# mro-copilot database in the SHARED postgres cluster (data-model.md) — the
# dedicated variable name keeps it isolated from turnaround-iq's DATABASE_URL.
MRO_DATABASE_URL=postgresql://turnaround:turnaround@localhost:5433/mro_copilot

# mro-copilot session signing secret (falls back to AUTH_SECRET if unset).
# The cookie name is mro-specific so both apps can run on localhost at once.
MRO_AUTH_COOKIE_NAME=mro_session

# Internal ai-service (ADR-0012) — loopback only, bearer-protected.
MRO_AI_SERVICE_URL=http://127.0.0.1:4103
AI_SERVICE_TOKEN=dev-only-insecure-ai-token-0123456789abcdef
