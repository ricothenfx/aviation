# TurnaroundIQ local development — every value here is a throwaway dev default.
# Copy to .env for host-side runs:  cp .env.example .env

# PostgreSQL (docker compose profile "infra" publishes 5433 on the host)
DATABASE_URL=postgresql://turnaround:turnaround@localhost:5433/turnaround_iq

# Redis (compose publishes 6379 on the host) — live projections + pub/sub only
REDIS_URL=redis://localhost:6379

# Session signing secret. Generate a real one: openssl rand -base64 32
# Must match for web AND realtime-gateway (ws tokens share the key).
AUTH_SECRET=replace-with-a-generated-32+-char-secret

# Session cookie name (httpOnly)
AUTH_COOKIE_NAME=tiq_session

# Realtime gateway ws endpoint the browser connects to (compose publishes 4001)
NEXT_PUBLIC_WS_URL=ws://localhost:4001/api/ws

# Service ports (compose: simulator 4101, realtime-gateway 4001)
SIMULATOR_PORT=4101
GATEWAY_PORT=4001

# LLM gateway provider for the turnaround-iq copilot (ADR-0003) — shared with
# the other apps via the single root block at the bottom of this file.
# (Mock is the mandatory offline default; see "Optional real LLM" below.)

# ---------------------------------------------------------------------------
# mro-copilot (compose profile "mro": web :3003, ai-service :4103 loopback)
# ---------------------------------------------------------------------------

# mro-copilot database in the SHARED postgres cluster (data-model.md) — the
# dedicated variable name keeps it isolated from turnaround-iq's DATABASE_URL.
MRO_DATABASE_URL=postgresql://turnaround:turnaround@localhost:5433/mro_copilot

# mro-copilot session signing secret (falls back to AUTH_SECRET if unset).
# The cookie name is mro-specific so both apps can run on localhost at once.
MRO_AUTH_COOKIE_NAME=mro_session

# Internal ai-service (ADR-0012) — loopback only, bearer-protected.
MRO_AI_SERVICE_URL=http://127.0.0.1:4103
AI_SERVICE_TOKEN=dev-only-insecure-ai-token-0123456789abcdef

# ---------------------------------------------------------------------------
# rebook-ai (compose profile "rebook": web :3004, orchestrator :4104 loopback)
# ---------------------------------------------------------------------------

# rebook-ai database in the SHARED postgres cluster (rebook-ai data-model.md,
# ADR-0015) — the dedicated variable name keeps it isolated from the other
# projects' DATABASE_URL values in the shared root .env.
REBOOK_DATABASE_URL=postgresql://turnaround:turnaround@localhost:5433/rebook_ai

# rebook-ai session signing secret (falls back to AUTH_SECRET if unset).
# The cookie name is rebook-specific so all apps can run on localhost at once.
REBOOK_AUTH_COOKIE_NAME=rbo_session

# Orchestrator service port (compose publishes 4104, loopback only — ADR-0014).
ORCHESTRATOR_PORT=4104

# LLM gateway provider for the agent loop (ADR-0003) — shared root block below.
# "off" exercises the degrade-to-rules path (source: rules).

# ---------------------------------------------------------------------------
# Optional real LLM (ADR-0017/D-23) — shared by tiq web, mro web, rebook web
# + orchestrator. Leave LLM_PROVIDER=mock for offline demos, CI, benches and
# evals (deterministic, cost-zero). To opt in, set the provider and paste your
# key here (never commit the filled-in .env):
#
#   LLM_PROVIDER=openai-compatible
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
#   OPENAI_MODEL=gpt-4o-mini                    # chat model
#
# Notes: a missing key degrades to the labeled rules/extractive paths (never a
# crash). The mro ai-service stays on mock regardless — it owns the 384-dim
# embedding vector space (ADR-0012 §2); real embeddings need a future ADR.
# ---------------------------------------------------------------------------

LLM_PROVIDER=mock
