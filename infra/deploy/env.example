# Public demo hostname (must resolve to this server) and ACME contact.
DOMAIN=demo.example.com
ACME_EMAIL=you@example.com

# Session signing secret — generate with: openssl rand -hex 32
AUTH_SECRET=

# Database password — generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Browser-facing WebSocket URL (derived from DOMAIN if unset).
# PUBLIC_WS_URL=wss://demo.example.com/api/ws
