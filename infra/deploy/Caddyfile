# Caddy entrypoint (ADR-0006): automatic Let's Encrypt TLS for the demo domain.
# Web (REST + pages) and the realtime WebSocket share one hostname — path-based
# routing keeps cookies and CORS trivial.
#
# The portfolio landing page (ADR-0019) is a static site served by the same
# front: build apps/portfolio-landing, copy out/ into ./landing on the host.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Realtime gateway — WebSocket upgrade passes through unchanged.
	handle /api/ws* {
		reverse_proxy realtime-gateway:4001
	}

	# Everything else: Next.js web (pages + /api/v1 REST).
	handle {
		reverse_proxy web:3000
	}

	encode gzip
}

# Portfolio landing page — prebuilt static export, no upstream (ADR-0019).
{$LANDING_DOMAIN:aviation.ricothen.com} {
	root * {$LANDING_ROOT:/srv/landing}
	# Landing pages are single-route: any unknown path falls back to index.
	try_files {path} /index.html
	file_server
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}

# ro.botriv.com — RO BOTRIV trading bot platform (dev on this VPS; see ro-botriv/docs/06-ENVIRONMENTS.md).
# Additive block: does not affect the sites above.
ro.botriv.com {
	# API + OAuth callback + SSE realtime stay on the backend (exact-match
	# redirect URI /callback must keep hitting the API — ro-botriv docs/06).
	handle /api/* {
		reverse_proxy 172.19.0.1:3001
	}
	handle /callback {
		reverse_proxy 172.19.0.1:3001
	}
	# SPA static (M3) — built from ro-botriv apps/web, deployed via its
	# scripts/deploy-web.sh into the bind-mounted read-only dir below.
	handle {
		root * /srv/ro-botriv-web
		try_files {path} /index.html
		file_server
	}
	encode gzip
}
