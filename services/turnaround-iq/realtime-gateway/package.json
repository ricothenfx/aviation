{
  "name": "@aviation/tiq-realtime-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turnaround-iq realtime gateway: projection worker (Redis read models) + ws delta broadcast (architecture.md §2–4).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
